<!-- app/views/companies/_form.html.erb -->
<%= form_with model: company, class: "space-y-5" do |f| %>
  <% if company.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800">
      <p class="font-medium"><%= pluralize(company.errors.count, "error") %> prevented this company from being saved:</p>
      <ul class="mt-2 list-disc pl-5">
        <% company.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_field :name,
          required: true,
          placeholder: "e.g., Prosperna, Sun Life, SpecifyX",
          class: "mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.label :website, class: "block text-sm font-medium text-slate-700" %>
    <%= f.url_field :website,
          placeholder: "https://example.com",
          class: "mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_area :description,
          rows: 6,
          placeholder: "What does your company do? Team size, stack, culture, benefits…",
          class: "mt-1 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
  </div>

  <div class="flex items-center justify-between gap-3 pt-2">
    <%= link_to "Cancel", companies_path, class: "text-sm font-medium text-slate-600 hover:underline" %>
    <%= f.submit (company.persisted? ? "Update Company" : "Create Company"),
          class: "rounded-xl bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700" %>
  </div>
<% end %>