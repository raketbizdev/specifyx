<% content_for :title, @company.name %>

<div class="mx-auto max-w-6xl px-4 py-8">
  <!-- Header -->
  <div class="flex items-center justify-between gap-3">
    <div class="flex items-center gap-2">
      <%= link_to companies_path,
          class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-200
                  px-3 py-2 text-sm sm:px-2.5 sm:py-1.5
                  font-medium text-slate-700 hover:bg-slate-50" do %>
        <span class="material-symbols-rounded text-base sm:text-sm" aria-hidden="true">arrow_back</span>
        <span>Back</span>
      <% end %>

      <h1 class="text-2xl font-semibold text-slate-900"><%= @company.name %></h1>
    </div>

    <!-- Company actions -->
    <div class="flex items-center gap-2">
      <% if current_user.admin? || @company.user_id == current_user.id %>
        <%= link_to new_company_job_path(@company),
            class: "inline-flex items-center gap-1.5 rounded-lg border border-indigo-200 bg-indigo-50
                    px-3 py-2 text-sm sm:px-2.5 sm:py-1.5
                    font-medium text-indigo-700 hover:bg-indigo-100" do %>
          <span class="material-symbols-rounded text-base sm:text-sm" aria-hidden="true">work</span>
          <span>New Job</span>
        <% end %>

        <%= link_to edit_company_path(@company),
            class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-200
                    px-3 py-2 text-sm sm:px-2.5 sm:py-1.5
                    font-medium text-slate-800 hover:bg-slate-50" do %>
          <span class="material-symbols-rounded text-base sm:text-sm" aria-hidden="true">edit</span>
          <span>Edit</span>
        <% end %>

        <%= button_to company_path(@company),
              method: :delete,
              data: { turbo_confirm: "Delete #{@company.name}? This cannot be undone." },
              form: { class: "inline" },
              class: "inline-flex items-center gap-1.5 rounded-lg border border-red-200 bg-red-50
                      px-3 py-2 text-sm sm:px-2.5 sm:py-1.5
                      font-medium text-red-700 hover:bg-red-100" do %>
          <span class="material-symbols-rounded text-base sm:text-sm" aria-hidden="true">delete</span>
          <span>Delete</span>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Company details card -->
  <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex flex-col gap-3">
      <% if @company.website.present? %>
        <% raw_url = @company.website.to_s.strip %>
        <% href    = raw_url =~ /\Ahttps?:\/\//i ? raw_url : "https://#{raw_url}" %>
        <% host    = (URI.parse(href).host rescue raw_url) %>

        <div class="text-sm text-slate-700">
          <%= link_to href, target: "_blank", rel: "noopener", class: "inline-flex items-center gap-1.5 text-indigo-700 hover:underline" do %>
            <span class="material-symbols-rounded text-base" aria-hidden="true">public</span>
            <span><%= host %></span>
            <span class="material-symbols-rounded text-sm" aria-hidden="true">open_in_new</span>
          <% end %>
        </div>
      <% end %>

      <% if @company.description.present? %>
        <p class="text-slate-700 leading-relaxed"><%= simple_format(@company.description) %></p>
      <% else %>
        <p class="text-slate-500 text-sm">No description provided.</p>
      <% end %>

      <div class="mt-2 text-xs text-slate-500">
        <span>Created <%= time_ago_in_words(@company.created_at) %> ago</span>
        ·
        <span>Updated <%= time_ago_in_words(@company.updated_at) %> ago</span>
      </div>
    </div>
  </div>

  <!-- Jobs section header -->
  <div class="mt-8 flex items-center justify-between gap-3">
    <h2 class="text-lg font-semibold text-slate-900">
      Jobs <span class="ml-1 text-slate-500 font-normal">(<%= @jobs.size %>)</span>
    </h2>

    <% if current_user.admin? || @company.user_id == current_user.id %>
      <%= link_to new_company_job_path(@company),
          class: "inline-flex items-center gap-1.5 rounded-lg border border-indigo-200 bg-indigo-50
                  px-3 py-2 text-sm sm:px-2.5 sm:py-1.5
                  font-medium text-indigo-700 hover:bg-indigo-100" do %>
        <span class="material-symbols-rounded text-base sm:text-sm" aria-hidden="true">add</span>
        <span>Post Job</span>
      <% end %>
    <% end %>
  </div>

  <!-- Jobs list -->
  <% if @jobs.blank? %>
    <div class="mt-4 rounded-xl border border-slate-200 bg-white p-6 text-slate-700">
      <p class="text-sm">No jobs posted yet.</p>
      <% if current_user.admin? || @company.user_id == current_user.id %>
        <div class="mt-3">
          <%= link_to new_company_job_path(@company),
              class: "inline-flex items-center gap-1.5 text-sm font-medium text-indigo-700 hover:underline" do %>
            <span class="material-symbols-rounded text-sm" aria-hidden="true">work</span>
            <span>Post your first job</span>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% @jobs.each do |job| %>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm hover:shadow transition">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 class="text-base font-semibold text-slate-900">
                <%= link_to job_path(job), class: "hover:underline" do %>
                  <%= job.title %>
                <% end %>
              </h3>
              <p class="mt-1 text-xs text-slate-500">
                <%= [job.location.presence, job.employment_type.presence].compact.join(" · ") %>
              </p>
            </div>
          </div>

          <!-- Job actions -->
          <div class="mt-4 flex flex-nowrap items-center gap-2">
            <!-- View -->
            <%= link_to job_path(job),
                class: "shrink-0 inline-flex items-center gap-1.5 rounded-lg border border-slate-200
                        px-4 py-2 text-sm sm:px-2.5 sm:py-1.5
                        font-medium text-slate-800 hover:bg-slate-50" do %>
              <span class="material-symbols-rounded text-base sm:text-sm" aria-hidden="true">visibility</span>
              <span>View</span>
            <% end %>

            <% if current_user.admin? || @company.user_id == current_user.id %>
              <!-- Applications -->
              <%= link_to job_job_applications_path(job),
                  class: "shrink-0 inline-flex items-center gap-1.5 rounded-lg border border-slate-200
                          px-4 py-2 text-sm sm:px-2.5 sm:py-1.5
                          font-medium text-slate-800 hover:bg-slate-50" do %>
                <span class="material-symbols-rounded text-base sm:text-sm" aria-hidden="true">inbox</span>
                <span>Applications</span>
              <% end %>

              <!-- Edit -->
              <%= link_to edit_job_path(job),
                  class: "shrink-0 inline-flex items-center gap-1.5 rounded-lg border border-slate-200
                          px-4 py-2 text-sm sm:px-2.5 sm:py-1.5
                          font-medium text-slate-800 hover:bg-slate-50" do %>
                <span class="material-symbols-rounded text-base sm:text-sm" aria-hidden="true">edit</span>
                <span>Edit</span>
              <% end %>

              <!-- Delete -->
              <%= button_to job_path(job),
                    method: :delete,
                    data: { turbo_confirm: "Delete '#{job.title}'? This cannot be undone." },
                    form: { class: "inline" },
                    class: "shrink-0 inline-flex items-center gap-1.5 rounded-lg border border-red-200 bg-red-50
                            px-4 py-2 text-sm sm:px-2.5 sm:py-1.5
                            font-medium text-red-700 hover:bg-red-100" do %>
                <span class="material-symbols-rounded text-base sm:text-sm" aria-hidden="true">delete</span>
                <span>Delete</span>
              <% end %>
            <% end %>
          </div>
          <!-- /Job actions -->
        </div>
      <% end %>
    </div>
  <% end %>
</div>