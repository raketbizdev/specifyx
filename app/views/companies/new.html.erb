<!-- app/views/companies/new.html.erb -->
<% content_for :title, "New Company" %>

<div class="mx-auto max-w-3xl px-4 py-8">
  <div class="flex items-center justify-between gap-3">
    <h1 class="text-2xl font-semibold text-slate-900">Create Company</h1>
    <%= link_to "Back", companies_path, class: "text-sm font-medium text-slate-600 hover:underline" %>
  </div>

  <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <%= render "form", company: @company %>
  </div>
</div>