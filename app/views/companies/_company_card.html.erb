<%# locals: company %>
<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition">
  <div class="flex items-start justify-between gap-3">
    <div>
      <h3 class="text-base font-semibold text-slate-900">
        <%= link_to company_path(company), class: "hover:underline" do %>
          <%= company.name %>
        <% end %>
      </h3>

      <% if company.website.present? %>
        <% raw_url = company.website.to_s.strip %>
        <% href    = raw_url =~ /\Ahttps?:\/\//i ? raw_url : "https://#{raw_url}" %>
        <% host    = (URI.parse(href).host rescue raw_url) %>
        <p class="mt-1 text-xs text-slate-500">
          <%= link_to href, target: "_blank", rel: "noopener", class: "inline-flex items-center gap-1.5 hover:underline" do %>
            <span class="material-symbols-rounded text-sm" aria-hidden="true">open_in_new</span>
            <span><%= host %></span>
          <% end %>
        </p>
      <% end %>
    </div>
  </div>

  <% if company.description.present? %>
    <p class="mt-3 text-sm leading-relaxed text-slate-600 line-clamp-3"><%= company.description %></p>
  <% end %>

  <div class="mt-4 flex items-center justify-between text-xs text-slate-500">
    <span><%= pluralize((company[:jobs_count] || 0), "job") %></span>
    <span>Updated <%= time_ago_in_words(company.updated_at) %> ago</span>
  </div>

  <div class="mt-4 flex items-center gap-2">
    <%= link_to company_path(company),
        class: "inline-flex items-center gap-1.5 rounded-xl border border-slate-200 px-3 py-1.5 text-sm font-medium text-slate-800 hover:bg-slate-50" do %>
      <span class="material-symbols-rounded text-sm" aria-hidden="true">visibility</span>
      <span>View</span>
    <% end %>

    <%= link_to company_path(company, anchor: "jobs"),
        class: "inline-flex items-center gap-1.5 rounded-xl border border-slate-200 px-3 py-1.5 text-sm font-medium text-slate-800 hover:bg-slate-50" do %>
      <span class="material-symbols-rounded text-sm" aria-hidden="true">work</span>
      <span>Open roles</span>
    <% end %>
  </div>
</div>
