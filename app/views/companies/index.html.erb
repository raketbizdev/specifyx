<% content_for :title, "Companies" %>

<div class="mx-auto max-w-6xl px-4 py-8">
  <div class="flex items-center justify-between gap-3">
    <h1 class="text-2xl font-semibold text-slate-900">Companies</h1>

    <%= link_to new_company_path,
        class: "inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-700" do %>
      <span class="material-symbols-rounded text-base" aria-hidden="true">add</span>
      <span>New Company</span>
    <% end %>
  </div>

  <% if @companies.blank? %>
    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 text-slate-700">
      <p class="text-sm">No companies yet.</p>
      <div class="mt-3">
        <%= link_to new_company_path,
            class: "inline-flex items-center gap-1 text-sm font-medium text-indigo-600 hover:underline" do %>
          <span class="material-symbols-rounded text-sm" aria-hidden="true">add</span>
          <span>Create your first company</span>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% @companies.each do |company| %>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm hover:shadow transition">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 class="text-base font-semibold text-slate-900">
                <%= link_to company_path(company), class: "hover:underline inline-flex items-center gap-1" do %>
                  <span><%= company.name %></span>
                <% end %>
              </h3>

              <% if company.website.present? %>
                <% raw_url = company.website.to_s.strip %>
                <% href    = raw_url =~ /\Ahttps?:\/\//i ? raw_url : "https://#{raw_url}" %>
                <% host    = (URI.parse(href).host rescue raw_url) %>

                <p class="mt-1 text-xs text-slate-500">
                  <%= link_to href, target: "_blank", rel: "noopener", class: "hover:underline inline-flex items-center gap-1" do %>
                    <span class="material-symbols-rounded text-xs" aria-hidden="true">open_in_new</span>
                    <span><%= host %></span>
                  <% end %>
                </p>
              <% end %>
            </div>

            <% if current_user.admin? %>
              <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-700 ring-1 ring-slate-200">
                Owner: <span class="ml-1 font-medium"><%= company.user.email %></span>
              </span>
            <% end %>
          </div>

          <% if company.description.present? %>
            <p class="mt-3 text-sm leading-relaxed text-slate-600 line-clamp-3"><%= company.description %></p>
          <% end %>

          <div class="mt-4 flex items-center justify-between text-xs text-slate-500">
            <span><%= pluralize(company.jobs.count, "job") %></span>
            <span>Updated <%= time_ago_in_words(company.updated_at) %> ago</span>
          </div>

          <!-- ACTIONS: bigger on mobile, smaller on desktop; stay in a single row -->
          <div class="mt-4 flex flex-nowrap items-center gap-2 overflow-x-auto">
            <!-- View -->
            <%= link_to company_path(company),
                class: "shrink-0 inline-flex items-center gap-1 rounded-lg border border-slate-200
                        px-3 py-2 text-sm
                        sm:px-2 sm:py-1.5 sm:text-xs
                        font-medium text-slate-800 hover:bg-slate-50" do %>
              <span class="material-symbols-rounded text-lg sm:text-base" aria-hidden="true">visibility</span>
              <!-- hide text on mobile, show on desktop -->
              <span class="hidden sm:inline">View</span>
              <span class="sr-only sm:hidden">View</span>
            <% end %>

            <% if current_user.admin? || company.user_id == current_user.id %>
              <!-- Post Job -->
              <%= link_to new_company_job_path(company),
                  class: "shrink-0 inline-flex items-center gap-1 rounded-lg border border-indigo-200 bg-indigo-50
                          px-3 py-2 text-sm
                          sm:px-2 sm:py-1.5 sm:text-xs
                          font-medium text-indigo-700 hover:bg-indigo-100" do %>
                <span class="material-symbols-rounded text-lg sm:text-base" aria-hidden="true">work</span>
                <span class="hidden sm:inline">Post Job</span>
                <span class="sr-only sm:hidden">Post Job</span>
              <% end %>

              <!-- Edit -->
              <%= link_to edit_company_path(company),
                  class: "shrink-0 inline-flex items-center gap-1 rounded-lg border border-slate-200
                          px-3 py-2 text-sm
                          sm:px-2 sm:py-1.5 sm:text-xs
                          font-medium text-slate-800 hover:bg-slate-50" do %>
                <span class="material-symbols-rounded text-lg sm:text-base" aria-hidden="true">edit</span>
                <span class="hidden sm:inline">Edit</span>
                <span class="sr-only sm:hidden">Edit</span>
              <% end %>

              <!-- Delete -->
              <%= button_to company_path(company),
                    method: :delete,
                    data: { turbo_confirm: "Delete #{company.name}? This cannot be undone." },
                    form: { class: "inline" },
                    class: "shrink-0 inline-flex items-center gap-1 rounded-lg border border-red-200 bg-red-50
                            px-3 py-2 text-sm
                            sm:px-2 sm:py-1.5 sm:text-xs
                            font-medium text-red-700 hover:bg-red-100" do %>
                <span class="material-symbols-rounded text-lg sm:text-base" aria-hidden="true">delete</span>
                <span class="hidden sm:inline">Delete</span>
                <span class="sr-only sm:hidden">Delete</span>
              <% end %>
            <% end %>
          </div>
          <!-- /ACTIONS -->
        </div>
      <% end %>
    </div>
  <% end %>
</div>
