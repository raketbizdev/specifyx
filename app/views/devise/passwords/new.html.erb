<%= render "shared/auth_card", title: "Forgot your password?" do %>
  <%= form_for(resource,
               as: resource_name,
               url: password_path(resource_name),
               html: { method: :post, class: "space-y-2" }) do |f| %>

    <%= render "devise/shared/error_messages", resource: resource %>

    <%= render "shared/form_input",
               f: f,
               field: :email,
               type: :email_field,
               label: "Email",
               autocomplete: "email",
               autofocus: true,
               placeholder: "you@company.com" %>

    <%= render "shared/form_actions",
               f: f,
               primary_label: "Send reset instructions" do %>
      <% content_for :secondary_actions do %>
        <div class="flex items-center justify-between text-sm">
          <%= link_to "Back to Log in",
              new_session_path(resource_name),
              class: "text-indigo-600 hover:underline" %>
          <%= link_to "Create an account",
              new_registration_path(resource_name),
              class: "text-gray-700 hover:underline" %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <% content_for :auth_footer do %>
    <div class="text-sm text-gray-600">
      <%= link_to "Didn’t receive confirmation instructions?",
                  new_confirmation_path(resource_name),
                  class: "text-indigo-600 hover:underline" %>
    </div>
  <% end %>
<% end %>
