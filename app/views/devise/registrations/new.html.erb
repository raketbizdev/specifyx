<%= render "shared/auth_card", title: "Create your account" do %>
  <%= form_for(resource,
               as: resource_name,
               url: registration_path(resource_name),
               html: { class: "space-y-2" }) do |f| %>

    <%= render "devise/shared/error_messages", resource: resource %>

    <%= render "shared/form_input",
               f: f,
               field: :email,
               type: :email_field,
               label: "Email",
               autocomplete: "email",
               autofocus: true,
               placeholder: "you@company.com" %>

    <%= render "shared/form_input",
               f: f,
               field: :password,
               type: :password_field,
               label: "Password",
               autocomplete: "new-password",
               placeholder: "••••••••",
               hint: (@minimum_password_length ? "#{@minimum_password_length} characters minimum" : nil) %>

    <%= render "shared/form_input",
               f: f,
               field: :password_confirmation,
               type: :password_field,
               label: "Confirm password",
               autocomplete: "new-password",
               placeholder: "••••••••" %>

    <%= render "shared/form_actions", f: f, primary_label: "Sign up" do %>
      <% content_for :secondary_actions do %>
        <div class="text-center text-sm">
          <%= link_to "Log in", new_session_path(resource_name), class: "text-indigo-600 hover:underline" %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <% content_for :auth_footer do %>
    <div class="text-sm text-gray-600 space-y-1">
      <%= link_to "Didn’t receive confirmation instructions?",
                  new_confirmation_path(resource_name),
                  class: "text-indigo-600 hover:underline" %><br>
      <%= link_to "Didn’t receive unlock instructions?",
                  new_unlock_path(resource_name),
                  class: "text-indigo-600 hover:underline" %>
    </div>
  <% end %>
<% end %>