<nav class="sticky top-0 z-40 border-b border-sky-100 bg-white/70 backdrop-blur"
     data-controller="nav">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4">

    <!-- Left: Brand -->
    <div class="flex items-center gap-2">
      <%= link_to root_path, class: "flex items-center gap-2" do %>
        <svg class="h-8 w-8" aria-hidden="true">
          <use href="#sx-logo"></use>
        </svg>
      <% end %>
    </div>

    <!-- Center: Primary Nav (desktop only) — public listings -->
    <div class="hidden md:flex items-center gap-1">
      <%= nav_link_to "Jobs", job_listings_path, match: :starts_with %>
      <%= nav_link_to "Companies", company_listings_path, match: :starts_with %>
    </div>

    <!-- Right: Actions (desktop only) -->
    <div class="hidden md:flex items-center gap-3">
      <% if user_signed_in? %>
        <!-- My Job Listings (user’s own jobs index) -->
        <%= nav_link_to "My Job Listings", jobs_path, match: :starts_with %>

        <%= role_chip(current_user.role) %>

        <%# Company-aware "New Job" CTA (defensive) %>
        <% primary_company = current_user.companies.order(:created_at).first %>
        <% if current_user.admin? %>
          <%= link_to companies_path,
                class: "inline-flex items-center gap-2 rounded-lg border border-sky-200 px-3 py-1.5 text-sm font-medium text-sky-900 hover:bg-sky-50" do %>
            <span aria-hidden="true">＋</span><span>New Job</span>
          <% end %>
        <% elsif primary_company.present? %>
          <%= link_to new_company_job_path(primary_company),
                class: "inline-flex items-center gap-2 rounded-lg border border-sky-200 px-3 py-1.5 text-sm font-medium text-sky-900 hover:bg-sky-50" do %>
            <span aria-hidden="true">＋</span><span>New Job</span>
          <% end %>
        <% else %>
          <%= link_to new_company_path,
                class: "inline-flex items-center gap-2 rounded-lg border border-sky-200 px-3 py-1.5 text-sm font-medium text-sky-900 hover:bg-sky-50" do %>
            <span aria-hidden="true">＋</span><span>Create Company</span>
          <% end %>
        <% end %>

        <!-- Avatar dropdown -->
        <div class="relative">
          <button
            data-action="click->nav#toggle click@window->nav#outside"
            data-nav-target="button"
            class="flex h-9 w-9 items-center justify-center rounded-full bg-sky-100 text-sky-900 font-semibold ring-1 ring-sky-200 hover:ring-sky-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500"
            aria-haspopup="menu" aria-expanded="false" aria-controls="user-menu" title="Account">
            <%= avatar_initials(current_user) %>
          </button>

          <div id="user-menu"
               data-nav-target="menu"
               class="invisible absolute right-0 mt-2 w-48 origin-top-right scale-95 transform rounded-lg border border-gray-100 bg-white p-1 shadow-lg opacity-0 transition"
               role="menu" aria-label="User menu" tabindex="-1">
            <%= link_to profile_path,  class: "block w-full rounded-md px-3 py-2 text-sm text-gray-700 hover:bg-gray-50", role: "menuitem" do %>My Profile<% end %>
            <%= link_to edit_user_registration_path, class: "block w-full rounded-md px-3 py-2 text-sm text-gray-700 hover:bg-gray-50", role: "menuitem" do %>Settings<% end %>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete,
                  form: { class: "w-full" },
                  class: "block w-full rounded-md px-3 py-2 text-left text-sm text-red-600 hover:bg-red-50",
                  role: "menuitem" %>
          </div>
        </div>
      <% else %>
        <%= link_to new_user_session_path,      class: "text-sm text-gray-700 hover:underline" do %>Sign in<% end %>
        <%= link_to new_user_registration_path, class: "rounded-lg bg-sky-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-sky-700" do %>Sign up<% end %>
      <% end %>
    </div>

    <!-- Mobile: Hamburger -->
    <button
      class="md:hidden inline-flex h-9 w-9 items-center justify-center rounded-md border border-gray-200 bg-white text-gray-700 hover:bg-gray-50"
      data-action="click->nav#toggleMobile"
      aria-label="Open menu" aria-expanded="false" data-nav-target="mobileButton">
      ☰
    </button>
  </div>

  <!-- Mobile sheet -->
  <div data-nav-target="mobilePanel" class="md:hidden hidden border-t border-gray-100 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-3 space-y-1">
      <!-- Public listings -->
      <%= nav_link_to "Jobs", job_listings_path, match: :starts_with, class: "block px-2 py-2 rounded-md" %>
      <%= nav_link_to "Companies", company_listings_path, match: :starts_with, class: "block px-2 py-2 rounded-md" %>

      <% if user_signed_in? %>
        <!-- User’s own jobs index -->
        <%= nav_link_to "My Job Listings", jobs_path, match: :starts_with, class: "block px-2 py-2 rounded-md" %>
        <%= nav_link_to "My Profile", profile_path, class: "block px-2 py-2 rounded-md" %>

        <% primary_company = current_user.companies.order(:created_at).first %>
        <% if current_user.admin? %>
          <%= link_to companies_path, class: "block rounded-md border border-sky-200 px-3 py-2 text-sm font-medium text-sky-900 hover:bg-sky-50" do %>
            ＋ New Job
          <% end %>
        <% elsif primary_company.present? %>
          <%= link_to new_company_job_path(primary_company),
                      class: "block rounded-md border border-sky-200 px-3 py-2 text-sm font-medium text-sky-900 hover:bg-sky-50" do %>
            ＋ New Job
          <% end %>
        <% else %>
          <%= link_to new_company_path, class: "block rounded-md border border-sky-200 px-3 py-2 text-sm font-medium text-sky-900 hover:bg-sky-50" do %>
            ＋ Create Company
          <% end %>
        <% end %>

        <div class="flex items-center justify-between pt-2">
          <%= role_chip(current_user.role) %>
          <%= button_to "Sign out", destroy_user_session_path, method: :delete,
                class: "rounded-md bg-red-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-red-700" %>
        </div>
      <% else %>
        <%= link_to new_user_session_path,      class: "block px-2 py-2 text-sm text-gray-700 hover:underline" do %>Sign in<% end %>
        <%= link_to new_user_registration_path, class: "block rounded-md bg-sky-600 px-3 py-2 text-sm font-medium text-white hover:bg-sky-700" do %>Sign up<% end %>
      <% end %>
    </div>
  </div>
</nav>