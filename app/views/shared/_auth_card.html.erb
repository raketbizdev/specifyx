<div class="min-h-[70vh] flex items-center justify-center px-4">
  <div class="w-full max-w-md">
    <div class="bg-white/80 backdrop-blur border border-gray-200 rounded-2xl shadow-lg p-8">
      <%# Optional heading slot %>
      <% if local_assigns[:title].present? %>
        <h1 class="text-2xl font-semibold text-gray-900 mb-6"><%= title %></h1>
      <% end %>

      <%= yield %>

      <%# Optional footer slot (e.g., links) %>
      <% if content_for?(:auth_footer) %>
        <div class="mt-6 pt-6 border-t">
          <%= yield :auth_footer %>
        </div>
      <% end %>
    </div>
  </div>
</div>