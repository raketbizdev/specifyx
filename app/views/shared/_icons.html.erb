<!-- app/views/shared/_icons.html.erb -->
<svg xmlns="http://www.w3.org/2000/svg" style="display:none">
  <symbol id="sx-logo" viewBox="0 0 128 128" role="img" aria-label="SpecifyX icon">
    <!-- Key background (themeable with CSS variables) -->
    <rect x="8" y="8" width="112" height="112" rx="28" fill="var(--sx-key-bg, #FFFFFF)"/>
    <rect x="8.5" y="8.5" width="111" height="111" rx="27.5"
          fill="none" stroke="var(--sx-border, #E5E7EB)"/>

    <!-- Underscore baseline -->
    <rect x="28" y="88" width="72" height="6" rx="3"
          fill="var(--sx-underscore, #CBD5E1)"/>

    <!-- Big X -->
    <text x="64" y="84" text-anchor="middle"
          font-family="Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto"
          font-size="64" font-weight="800"
          fill="var(--sx-x, #4F46E5)">X</text>

    <!-- Lightbulb with ? -->
    <!-- Bulb glass -->
    <circle cx="38" cy="38" r="16"
            fill="var(--sx-bulb-fill, #FEF3C7)"
            stroke="var(--sx-bulb-stroke, #F59E0B)" stroke-width="2"/>
    <!-- Bulb base + threads -->
    <rect x="32" y="52" width="12" height="8" rx="2"
          fill="var(--sx-bulb-stroke, #F59E0B)"/>
    <rect x="32" y="52" width="12" height="2" rx="1"
          fill="var(--sx-bulb-thread, #FB923C)"/>
    <rect x="32" y="56" width="12" height="2" rx="1"
          fill="var(--sx-bulb-thread, #FB923C)"/>
    <!-- Question mark -->
    <text x="38" y="44" text-anchor="middle"
          font-family="Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto"
          font-size="18" font-weight="800"
          fill="var(--sx-question, #92400E)">?</text>
  </symbol>
</svg>