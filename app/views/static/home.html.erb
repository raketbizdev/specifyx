<!-- HERO -->
<section class="relative w-full overflow-hidden bg-white">
  <!-- decorative blobs -->
  <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-24 h-96 w-96 rounded-full bg-gradient-to-tr from-indigo-400 to-fuchsia-400 opacity-20 blur-3xl"></div>
  <div aria-hidden="true" class="pointer-events-none absolute -bottom-24 -left-24 h-96 w-96 rounded-full bg-gradient-to-br from-cyan-300 to-emerald-400 opacity-20 blur-3xl"></div>

  <!-- subtle grid overlay -->
  <div aria-hidden="true" class="absolute inset-0 [background-image:linear-gradient(to_right,rgba(99,102,241,.06)_1px,transparent_1px),linear-gradient(to_bottom,rgba(99,102,241,.06)_1px,transparent_1px)]; [background-size:36px_36px]"></div>

  <!-- 72rem container -->
  <div class="relative max-w-6xl mx-auto px-4 py-24 sm:py-32">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="mt-4 text-4xl sm:text-6xl font-semibold tracking-tight text-gray-900">
        What’s Your X?
      </h1>

      <p class="mt-6 text-lg text-gray-600">
        SpecifyX helps you solve for X — whether it’s hiring your next team member, landing your next big role, or growing your career.
        One platform to connect companies and talents, from discovery to success.
      </p>

      <!-- CTAs -->
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
        <% if defined?(user_signed_in?) && user_signed_in? %>
          <% if current_user.companies.any? %>
            <% if current_user.companies.many? %>
              <!-- If multiple companies, show a small list of "Post a Job" per company -->
              <div class="flex flex-wrap items-center justify-center gap-2">
                <% current_user.companies.limit(3).each do |co| %>
                  <%= link_to "Post a Job at #{co.name}",
                      new_company_job_path(co),
                      class: "rounded-md bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
                <% end %>
                <% if current_user.companies.count > 3 %>
                  <%= link_to "View all companies →",
                      companies_path,
                      class: "rounded-md px-5 py-3 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
                <% end %>
              </div>
            <% else %>
              <!-- Single company → direct new job -->
              <%= link_to "Find talent (Post a Job)",
                  new_company_job_path(current_user.companies.first),
                  class: "rounded-md bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
            <% end %>
          <% else %>
            <!-- No company yet → create company first -->
            <%= link_to "Create a Company",
                new_company_path,
                class: "rounded-md bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
          <% end %>
        <% else %>
          <!-- Guest → sign in first -->
          <%= link_to "Find talent",
              (defined?(new_user_session_path) ? new_user_session_path : "#"),
              class: "rounded-md bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
        <% end %>

        <%= link_to "Search jobs",
            jobs_path,
            class: "rounded-md px-5 py-3 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      </div>
    </div>
  </div>
</section>
<!-- END HERO -->

<!-- COMPANY STEPS -->
<section class="relative w-full bg-white">
  <div class="absolute inset-x-0 -top-px h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent"></div>

  <div class="relative max-w-6xl mx-auto px-4 py-16">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">How SpecifyX works for companies</h2>
      <p class="hidden md:block text-sm text-slate-500">From sign-up to hire in six steps</p>
    </div>

    <ol class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- 1. Signup -->
      <li class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition">
        <div class="flex items-center gap-3">
          <div class="h-10 w-10 rounded-xl bg-indigo-600 text-white grid place-content-center font-semibold">1</div>
          <div class="font-medium text-slate-900">Sign up</div>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">
          Create your SpecifyX account to access employer tools and manage your hiring.
        </p>
      </li>

      <!-- 2. Create company -->
      <li class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition">
        <div class="flex items-center gap-3">
          <div class="h-10 w-10 rounded-xl bg-emerald-600 text-white grid place-content-center font-semibold">2</div>
          <div class="font-medium text-slate-900">Create company</div>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">
          Add your company profile, logo, and hiring preferences so candidates know who you are.
        </p>
      </li>

      <!-- 3. Post jobs -->
      <li class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition">
        <div class="flex items-center gap-3">
          <div class="h-10 w-10 rounded-xl bg-fuchsia-600 text-white grid place-content-center font-semibold">3</div>
          <div class="font-medium text-slate-900">Post jobs</div>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">
          Publish stack-specific roles (e.g., AWS, K8s, React, Rails) with clear requirements and location.
        </p>
      </li>

      <!-- 4. Select pre-vetted candidates -->
      <li class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition">
        <div class="flex items-center gap-3">
          <div class="h-10 w-10 rounded-xl bg-cyan-600 text-white grid place-content-center font-semibold">4</div>
          <div class="font-medium text-slate-900">Select pre-vetted candidates</div>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">
          Review ranked applicants with portfolios/GitHub and filter by skills, level, and availability.
        </p>
      </li>

      <!-- 5. Interview -->
      <li class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition">
        <div class="flex items-center gap-3">
          <div class="h-10 w-10 rounded-xl bg-amber-600 text-white grid place-content-center font-semibold">5</div>
          <div class="font-medium text-slate-900">Interview</div>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">
          Move shortlisted candidates through your pipeline and schedule interviews without friction.
        </p>
      </li>

      <!-- 6. Hire -->
      <li class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition">
        <div class="flex items-center gap-3">
          <div class="h-10 w-10 rounded-xl bg-violet-600 text-white grid place-content-center font-semibold">6</div>
          <div class="font-medium text-slate-900">Hire</div>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">
          Make the offer and onboard—then explore partners for training, equipment, or infra as you scale.
        </p>
      </li>
    </ol>

    <!-- Inline CTA under steps -->
    <div class="mt-10 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-indigo-200 bg-indigo-50/60 p-5">
      <div class="text-slate-800">
        <div class="font-medium">Ready to start?</div>
        <div class="text-sm text-slate-600">Post a role and reach the 580k+ PH tech community today.</div>
      </div>

      <% if defined?(user_signed_in?) && user_signed_in? %>
        <% if current_user.companies.any? %>
          <%= link_to "Post a Job",
              new_company_job_path(current_user.companies.order(:created_at).first),
              class: "px-4 py-2 rounded-xl bg-indigo-600 text-white hover:bg-indigo-700 shadow-sm transition" %>
        <% else %>
          <%= link_to "Create a Company",
              new_company_path,
              class: "px-4 py-2 rounded-xl bg-indigo-600 text-white hover:bg-indigo-700 shadow-sm transition" %>
        <% end %>
      <% else %>
        <%= link_to "Sign in to Post",
            (defined?(new_user_session_path) ? new_user_session_path : "#"),
            class: "px-4 py-2 rounded-xl bg-indigo-600 text-white hover:bg-indigo-700 shadow-sm transition" %>
      <% end %>
    </div>
  </div>
</section>
<!-- END COMPANY STEPS -->

<!-- JOB SEEKER STEPS -->
<section class="relative w-full bg-sky-50">
  <div class="absolute inset-x-0 -top-px h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent"></div>

  <div class="relative max-w-6xl mx-auto px-4 py-16">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">How SpecifyX works for job seekers</h2>
      <p class="hidden md:block text-sm text-slate-500">Three quick steps to land interviews</p>
    </div>

    <ol class="mt-8 grid sm:grid-cols-3 gap-6">
      <!-- 1. Signup -->
      <li class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition">
        <div class="flex items-center gap-3">
          <div class="h-10 w-10 rounded-xl bg-indigo-600 text-white grid place-content-center font-semibold">1</div>
          <div class="font-medium text-slate-900">Sign up</div>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">
          Create your free account to access tech roles and alerts.
        </p>
        <% if defined?(new_user_registration_path) %>
          <%= link_to "Create account →", new_user_registration_path, class: "mt-3 inline-block text-indigo-600 text-sm font-medium hover:underline" %>
        <% end %>
      </li>

      <!-- 2. Add profile -->
      <li class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition">
        <div class="flex items-center gap-3">
          <div class="h-10 w-10 rounded-xl bg-emerald-600 text-white grid place-content-center font-semibold">2</div>
          <div class="font-medium text-slate-900">Add profile</div>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">
          Showcase your stack (e.g., AWS, K8s, React, Rails) and link GitHub or portfolio for signal.
        </p>
        <%= link_to "Build my profile →",
            (defined?(edit_profile_path) ? edit_profile_path : "#"),
            class: "mt-3 inline-block text-indigo-600 text-sm font-medium hover:underline" %>
      </li>

      <!-- 3. Apply jobs -->
      <li class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition">
        <div class="flex items-center gap-3">
          <div class="h-10 w-10 rounded-xl bg-fuchsia-600 text-white grid place-content-center font-semibold">3</div>
          <div class="font-medium text-slate-900">Apply to jobs</div>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">
          Get matched to roles that fit your skills and apply with confidence.
        </p>
        <%= link_to "Search jobs →", jobs_path, class: "mt-3 inline-block text-indigo-600 text-sm font-medium hover:underline" %>
      </li>
    </ol>

    <!-- CTA bar -->
    <div class="mt-10 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-indigo-200 bg-indigo-50/60 p-5">
      <div class="text-slate-800">
        <div class="font-medium">Ready to get noticed?</div>
        <div class="text-sm text-slate-600">Create your tech profile and start applying today.</div>
      </div>
      <div class="flex gap-3">
        <%= link_to "Create my profile",
            (defined?(edit_profile_path) ? edit_profile_path : "#"),
            class: "px-4 py-2 rounded-xl bg-indigo-600 text-white hover:bg-indigo-700 shadow-sm transition" %>
        <%= link_to "Search jobs",
            jobs_path,
            class: "px-4 py-2 rounded-xl bg-white text-slate-900 ring-1 ring-slate-200 hover:bg-slate-50 transition" %>
      </div>
    </div>
  </div>
</section>
<!-- END JOB SEEKER STEPS -->

<!-- COMING SOON -->
<section class="relative w-full">
  <div class="absolute inset-0 bg-gradient-to-br from-indigo-50 via-white to-emerald-50"></div>

  <div class="relative max-w-6xl mx-auto px-4 py-16">
    <div class="flex items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl md:text-3xl font-semibold text-slate-900">Coming soon on SpecifyX</h2>
        <p class="mt-1 text-sm text-slate-600">One platform beyond hiring—grow your people and your business.</p>
      </div>
      <%= link_to "Suggest a feature →",
          (defined?(contact_path) ? contact_path : "#"),
          class: "hidden md:inline-block text-indigo-600 text-sm font-medium hover:underline" %>
    </div>

    <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Learning Management -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="material-symbols-rounded text-2xl text-indigo-600">school</span>
            <h3 class="font-medium text-slate-900">Learning Management</h3>
          </div>
          <span class="text-xs px-2 py-1 rounded-full bg-amber-100 text-amber-700 ring-1 ring-amber-200">Coming Soon</span>
        </div>
        <p class="mt-2 text-sm text-slate-600">Role-based paths, assessments, and certificates to upskill teams and candidates.</p>
        <ul class="mt-3 text-sm text-slate-600 space-y-1">
          <li>• Skill gaps → suggested courses</li>
          <li>• Company-curated tracks</li>
          <li>• Badge & certificate export</li>
        </ul>
      </div>

      <!-- HR -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="material-symbols-rounded text-2xl text-indigo-600">groups</span>
            <h3 class="font-medium text-slate-900">HR</h3>
          </div>
          <span class="text-xs px-2 py-1 rounded-full bg-emerald-100 text-emerald-700 ring-1 ring-emerald-200">Planned</span>
        </div>
        <p class="mt-2 text-sm text-slate-600">Onboarding, docs, time-off, and compliance to run people ops smoothly.</p>
        <ul class="mt-3 text-sm text-slate-600 space-y-1">
          <li>• Onboarding checklists</li>
          <li>• E-sign & document vault</li>
          <li>• Leave & approvals</li>
        </ul>
      </div>

      <!-- Payroll -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="material-symbols-rounded text-2xl text-indigo-600">payments</span>
            <h3 class="font-medium text-slate-900">Payroll</h3>
          </div>
          <span class="text-xs px-2 py-1 rounded-full bg-emerald-100 text-emerald-700 ring-1 ring-emerald-200">Planned</span>
        </div>
        <p class="mt-2 text-sm text-slate-600">Local-compliant payroll with deductions, benefits, and automated payouts.</p>
        <ul class="mt-3 text-sm text-slate-600 space-y-1">
          <li>• PH payroll support</li>
          <li>• Benefits & deductions</li>
          <li>• Reports & exports</li>
        </ul>
      </div>

      <!-- B2B Store -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="material-symbols-rounded text-2xl text-indigo-600">storefront</span>
            <h3 class="font-medium text-slate-900">B2B Store</h3>
          </div>
          <span class="text-xs px-2 py-1 rounded-full bg-amber-100 text-amber-700 ring-1 ring-amber-200">Coming Soon</span>
        </div>
        <p class="mt-2 text-sm text-slate-600">Training, equipment, and cloud credits from vetted partners—get quotes fast.</p>
        <ul class="mt-3 text-sm text-slate-600 space-y-1">
          <li>• Training & certifications</li>
          <li>• Laptops & dev gear</li>
          <li>• Servers / cloud credits</li>
        </ul>
      </div>

      <!-- ATS -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="material-symbols-rounded text-2xl text-indigo-600">assignment_turned_in</span>
            <h3 class="font-medium text-slate-900">ATS</h3>
          </div>
          <span class="text-xs px-2 py-1 rounded-full bg-emerald-100 text-emerald-700 ring-1 ring-emerald-200">Planned</span>
        </div>
        <p class="mt-2 text-sm text-slate-600">Signal-first pipeline that ranks by stack, recency, and proofs—not keyword spam.</p>
        <ul class="mt-3 text-sm text-slate-600 space-y-1">
          <li>• One-click shortlist & notes</li>
          <li>• Email/calendar sync</li>
          <li>• Offer templates</li>
        </ul>
      </div>

      <!-- Career Guidance -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="material-symbols-rounded text-2xl text-indigo-600">trending_up</span>
            <h3 class="font-medium text-slate-900">Career Guidance</h3>
          </div>
          <span class="text-xs px-2 py-1 rounded-full bg-emerald-100 text-emerald-700 ring-1 ring-emerald-200">Planned</span>
          </div>
        <p class="mt-2 text-sm text-slate-600">Personalized paths, mentors, and resources to move from role to promotion.</p>
        <ul class="mt-3 text-sm text-slate-600 space-y-1">
          <li>• Skills gap insights</li>
          <li>• Mentors & coaching</li>
          <li>• Role-based roadmaps</li>
        </ul>
      </div>
    </div>

    <!-- Interest capture -->
    <div class="mt-10 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <div class="font-medium text-slate-900">Want early access?</div>
          <p class="text-sm text-slate-600">Tell us what you need most and we’ll invite you to the pilot.</p>
        </div>
        <%= form_with url: (defined?(contact_path) ? contact_path : "#"), method: :get, local: true, class: "flex w-full sm:w-auto gap-3" do %>
          <input type="email" name="email" required placeholder="you@company.com"
                 class="w-full sm:w-72 rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          <button type="submit"
                  class="rounded-xl bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500">
            Notify me
          </button>
        <% end %>
      </div>
    </div>
  </div>
</section>
<!-- END COMING SOON -->

<%= render "shared/footer" %>