<%# app/views/public_profiles/show.html.erb %>
<div class="max-w-3xl mx-auto p-6">
  <div class="mb-6">
    <h1 class="text-2xl font-semibold">
      <%= @profile.display_name.presence || @profile.full_name %>
    </h1>
    <p class="text-sm text-gray-500">Public profile</p>
  </div>

  <div class="grid gap-6">
    <div class="rounded-2xl border p-5">
      <h2 class="mb-2 text-lg font-medium">About</h2>
      <% if @profile.bio.present? %>
        <p class="text-gray-700 whitespace-pre-line"><%= @profile.bio %></p>
      <% else %>
        <p class="text-gray-500 italic">No bio provided.</p>
      <% end %>
    </div>

    <div class="rounded-2xl border p-5">
      <h2 class="mb-2 text-lg font-medium">Skills</h2>
      <% skills = @profile.skills.to_s.split(",").map(&:strip).reject(&:blank?) %>
      <% if skills.any? %>
        <div class="flex flex-wrap gap-2">
          <% skills.each do |skill| %>
            <span class="rounded-full border px-3 py-1 text-sm"><%= skill %></span>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 italic">No skills listed.</p>
      <% end %>
    </div>
  </div>
</div>
