<% content_for :title, "New Job" %>

<div class="mx-auto max-w-3xl px-4 py-8">
  <!-- Header -->
  <div class="flex items-center justify-between gap-3">
    <div class="flex items-center gap-2">
      <%= link_to company_path(@company),
          class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-200
                  px-3 py-2 text-sm sm:px-2.5 sm:py-1.5
                  font-medium text-slate-700 hover:bg-slate-50" do %>
        <span class="material-symbols-rounded text-base sm:text-sm" aria-hidden="true">arrow_back</span>
        <span>Back</span>
      <% end %>

      <h1 class="text-2xl font-semibold text-slate-900">
        New Job <span class="text-slate-500 font-normal">at <%= @company&.name %></span>
      </h1>
    </div>

    <%# Optional: quick switch to company list (owner/admin) %>
    <% if current_user.admin? || (@company && @company.user_id == current_user.id) %>
      <%= link_to companies_path,
          class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-200
                  px-3 py-2 text-sm sm:px-2.5 sm:py-1.5
                  font-medium text-slate-800 hover:bg-slate-50" do %>
        <span class="material-symbols-rounded text-base sm:text-sm" aria-hidden="true">apartment</span>
        <span>Companies</span>
      <% end %>
    <% end %>
  </div>

  <%# Guard: must have a company to proceed %>
  <% if @company.blank? %>
    <div class="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-6 text-amber-900">
      <p class="font-medium">You need a company to post a job.</p>
      <div class="mt-3 flex gap-3">
        <%= link_to new_company_path,
            class: "inline-flex items-center gap-1.5 rounded-lg bg-indigo-600
                    px-4 py-2 text-sm sm:px-2.5 sm:py-1.5
                    font-medium text-white hover:bg-indigo-700" do %>
          <span class="material-symbols-rounded text-base sm:text-sm" aria-hidden="true">add</span>
          <span>Create Company</span>
        <% end %>
        <%= link_to companies_path,
            class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-200
                    px-4 py-2 text-sm sm:px-2.5 sm:py-1.5
                    font-medium text-slate-800 hover:bg-slate-50" do %>
          <span class="material-symbols-rounded text-base sm:text-sm" aria-hidden="true">apartment</span>
          <span>Choose Company</span>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <%= render "form", job: @job, company: @company %>
    </div>
  <% end %>
</div>