<% content_for :title, "Jobs" %>

<div class="mx-auto max-w-6xl px-4 py-8">
  <!-- Header -->
  <div class="flex items-center justify-between gap-3">
    <h1 class="text-2xl font-semibold text-slate-900">Jobs</h1>

    <% if user_signed_in? %>
      <% primary_company = current_user.companies.order(:created_at).first %>
      <% if current_user.admin? %>
        <%= link_to companies_path,
            class: "inline-flex items-center gap-1.5 rounded-lg border border-indigo-200 bg-indigo-50
                    px-4 py-2 text-sm sm:px-2.5 sm:py-1.5
                    font-medium text-indigo-700 hover:bg-indigo-100" do %>
          <span class="material-symbols-rounded text-base sm:text-sm" aria-hidden="true">add</span>
          <span>New Job</span>
        <% end %>
      <% elsif primary_company.present? %>
        <%= link_to new_company_job_path(primary_company),
            class: "inline-flex items-center gap-1.5 rounded-lg border border-indigo-200 bg-indigo-50
                    px-4 py-2 text-sm sm:px-2.5 sm:py-1.5
                    font-medium text-indigo-700 hover:bg-indigo-100" do %>
          <span class="material-symbols-rounded text-base sm:text-sm" aria-hidden="true">add</span>
          <span>New Job</span>
        <% end %>
      <% else %>
        <%= link_to new_company_path,
            class: "inline-flex items-center gap-1.5 rounded-lg border border-indigo-200 bg-indigo-50
                    px-4 py-2 text-sm sm:px-2.5 sm:py-1.5
                    font-medium text-indigo-700 hover:bg-indigo-100" do %>
          <span class="material-symbols-rounded text-base sm:text-sm" aria-hidden="true">add_business</span>
          <span>Create Company</span>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <% if @jobs.blank? %>
    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 text-slate-700">
      <p class="text-sm">No jobs posted yet.</p>
    </div>
  <% else %>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% @jobs.each do |job| %>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm hover:shadow transition">
          <% owner = current_user&.admin? || (user_signed_in? && job.company.user_id == current_user.id) %>

          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 class="text-base font-semibold text-slate-900">
                <%= link_to job_path(job), class: "hover:underline" do %>
                  <%= job.title %>
                <% end %>
              </h3>

              <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-slate-600">
                <%= link_to company_path(job.company),
                    class: "inline-flex items-center gap-1.5 rounded-md border border-slate-200 px-2 py-0.5 hover:bg-slate-50" do %>
                  <span class="material-symbols-rounded text-sm" aria-hidden="true">apartment</span>
                  <span><%= job.company.name %></span>
                <% end %>

                <% if job.location.present? %>
                  <span class="inline-flex items-center gap-1.5 rounded-md border border-slate-200 px-2 py-0.5">
                    <span class="material-symbols-rounded text-sm" aria-hidden="true">location_on</span>
                    <span><%= job.location %></span>
                  </span>
                <% end %>

                <% if job.employment_type.present? %>
                  <span class="inline-flex items-center gap-1.5 rounded-md border border-slate-200 px-2 py-0.5">
                    <span class="material-symbols-rounded text-sm" aria-hidden="true">schedule</span>
                    <span><%= job.employment_type %></span>
                  </span>
                <% end %>
              </div>
            </div>
          </div>

          <% if job.description.present? %>
            <p class="mt-3 text-sm leading-relaxed text-slate-600 line-clamp-3">
              <%= job.description %>
            </p>
          <% end %>

          <div class="mt-4 text-xs text-slate-500">
            Posted <%= time_ago_in_words(job.created_at) %> ago
          </div>

          <!-- Actions -->
          <div class="mt-4 flex flex-nowrap items-center gap-2">
            <!-- View -->
            <%= link_to job_path(job),
                class: "shrink-0 inline-flex items-center gap-1.5 rounded-lg border border-slate-200
                        px-4 py-2 text-sm sm:px-2.5 sm:py-1.5
                        font-medium text-slate-800 hover:bg-slate-50" do %>
              <span class="material-symbols-rounded text-base sm:text-sm" aria-hidden="true">visibility</span>
              <span>View</span>
            <% end %>

            <% if owner %>
              <!-- Applications -->
              <%= link_to job_job_applications_path(job),
                  class: "shrink-0 inline-flex items-center gap-1.5 rounded-lg border border-slate-200
                          px-4 py-2 text-sm sm:px-2.5 sm:py-1.5
                          font-medium text-slate-800 hover:bg-slate-50" do %>
                <span class="material-symbols-rounded text-base sm:text-sm" aria-hidden="true">inbox</span>
                <span>Applications</span>
              <% end %>

              <!-- Edit -->
              <%= link_to edit_job_path(job),
                  class: "shrink-0 inline-flex items-center gap-1.5 rounded-lg border border-slate-200
                          px-4 py-2 text-sm sm:px-2.5 sm:py-1.5
                          font-medium text-slate-800 hover:bg-slate-50" do %>
                <span class="material-symbols-rounded text-base sm:text-sm" aria-hidden="true">edit</span>
                <span>Edit</span>
              <% end %>

              <!-- Delete -->
              <%= button_to job_path(job),
                    method: :delete,
                    data: { turbo_confirm: "Delete “#{job.title}”? This cannot be undone." },
                    form: { class: "inline" },
                    class: "shrink-0 inline-flex items-center gap-1.5 rounded-lg border border-red-200 bg-red-50
                            px-4 py-2 text-sm sm:px-2.5 sm:py-1.5
                            font-medium text-red-700 hover:bg-red-100" do %>
                <span class="material-symbols-rounded text-base sm:text-sm" aria-hidden="true">delete</span>
                <span>Delete</span>
              <% end %>
            <% end %>
          </div>
          <!-- /Actions -->
        </div>
      <% end %>
    </div>
  <% end %>
</div>