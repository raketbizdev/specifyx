<% content_for :title, "Job Listings" %>

<!-- HERO / SEARCH -->
<section class="relative w-full overflow-hidden bg-white">
  <!-- decorative blobs -->
  <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-24 h-96 w-96 rounded-full bg-gradient-to-tr from-indigo-400 to-fuchsia-400 opacity-20 blur-3xl"></div>
  <div aria-hidden="true" class="pointer-events-none absolute -bottom-24 -left-24 h-96 w-96 rounded-full bg-gradient-to-br from-cyan-300 to-emerald-400 opacity-20 blur-3xl"></div>

  <!-- subtle grid overlay -->
  <div aria-hidden="true" class="absolute inset-0 [background-image:linear-gradient(to_right,rgba(99,102,241,.06)_1px,transparent_1px),linear-gradient(to_bottom,rgba(99,102,241,.06)_1px,transparent_1px)]; [background-size:36px_36px]"></div>

  <!-- container -->
  <div class="relative max-w-6xl mx-auto px-4 py-16 sm:py-20">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="mt-2 text-3xl sm:text-5xl font-semibold tracking-tight text-gray-900">
        Find your next role
      </h1>
      <p class="mt-4 text-base sm:text-lg text-gray-600">
        Search by stack, location, or employment type. Fresh roles from PH startups and global teams.
      </p>
    </div>

    <!-- SEARCH CARD -->
    <div class="mx-auto mt-8 max-w-4xl rounded-2xl border border-slate-200 bg-white p-4 sm:p-6 shadow-sm">
      <%= form_with url: job_listings_path, method: :get, local: true do %>
        <div class="grid gap-4 sm:grid-cols-3">
          <!-- Keywords -->
          <div>
            <label for="q" class="block text-sm font-medium text-slate-700">Keywords</label>
            <div class="relative">
              <span class="material-symbols-rounded pointer-events-none absolute left-2 top-1/2 -translate-y-1/2 text-base text-slate-400">search</span>
              <input id="q" type="search" name="q" value="<%= params[:q] %>" placeholder="e.g., rails, react, devops"
                     class="mt-1 w-full rounded-xl border border-slate-300 bg-white pl-8 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
          </div>

          <!-- Employment Type -->
          <div>
            <label for="employment_type" class="block text-sm font-medium text-slate-700">Employment type</label>
            <select id="employment_type" name="employment_type"
                    class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
              <option value="">Any</option>
              <% ["Full-time","Part-time","Contract","Internship","Temporary"].each do |opt| %>
                <option value="<%= opt %>" <%= "selected" if params[:employment_type].to_s == opt %>><%= opt %></option>
              <% end %>
            </select>
          </div>

          <!-- Location -->
          <div>
            <label for="location" class="block text-sm font-medium text-slate-700">Location</label>
            <div class="relative">
              <span class="material-symbols-rounded pointer-events-none absolute left-2 top-1/2 -translate-y-1/2 text-base text-slate-400">location_on</span>
              <input id="location" type="text" name="location" value="<%= params[:location] %>" placeholder="e.g., Makati, Remote (PH)"
                     class="mt-1 w-full rounded-xl border border-slate-300 bg-white pl-8 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
          </div>
        </div>

        <!-- Actions -->
        <div class="mt-4 flex flex-wrap items-center justify-end gap-2">
          <% if params[:q].present? || params[:employment_type].present? || params[:location].present? %>
            <%= link_to "Reset",
                job_listings_path,
                class: "inline-flex items-center gap-1.5 rounded-xl border border-slate-200 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
          <% end %>

          <button type="submit"
                  class="inline-flex items-center gap-1.5 rounded-xl bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700">
            <span class="material-symbols-rounded text-sm" aria-hidden="true">tune</span>
            <span>Apply Filters</span>
          </button>
        </div>
      <% end %>
    </div>
  </div>
</section>
<!-- /HERO / SEARCH -->

<!-- RESULTS BAND -->
<section class="relative w-full bg-sky-50">
  <div class="absolute inset-x-0 -top-px h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent"></div>

  <div class="relative mx-auto max-w-6xl px-4 py-10">
    <div class="flex items-center justify-between gap-3">
      <h2 class="text-lg font-semibold text-slate-900">
        Results <span class="ml-1 text-slate-600 font-normal">(<%= @jobs.size %>)</span>
      </h2>

      <% if params[:q].present? || params[:employment_type].present? || params[:location].present? %>
        <div class="flex flex-wrap items-center gap-2 text-xs">
          <% if params[:q].present? %>
            <span class="inline-flex items-center gap-1 rounded-full bg-white px-2 py-0.5 text-slate-700 ring-1 ring-slate-200">
              <span class="material-symbols-rounded text-sm">search</span><%= params[:q] %>
            </span>
          <% end %>
          <% if params[:employment_type].present? %>
            <span class="inline-flex items-center gap-1 rounded-full bg-white px-2 py-0.5 text-slate-700 ring-1 ring-slate-200">
              <span class="material-symbols-rounded text-sm">schedule</span><%= params[:employment_type] %>
            </span>
          <% end %>
          <% if params[:location].present? %>
            <span class="inline-flex items-center gap-1 rounded-full bg-white px-2 py-0.5 text-slate-700 ring-1 ring-slate-200">
              <span class="material-symbols-rounded text-sm">location_on</span><%= params[:location] %>
            </span>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if @jobs.blank? %>
      <div class="mt-6 rounded-2xl bg-white p-6 text-slate-700 ring-1 ring-slate-200">
        <p class="text-sm">No jobs matched your filters.</p>
        <ul class="mt-2 text-sm list-disc pl-5 text-slate-600 space-y-1">
          <li>Try fewer or broader keywords.</li>
          <li>Clear the location filter or use “Remote”.</li>
          <li>Select a different employment type.</li>
        </ul>
      </div>
    <% else %>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <% @jobs.each do |job| %>
          <!-- Job card -->
          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h3 class="text-base font-semibold text-slate-900">
                  <%= link_to job_path(job), class: "hover:underline" do %>
                    <%= job.title %>
                  <% end %>
                </h3>

                <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-slate-600">
                  <%= link_to company_path(job.company),
                      class: "inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-0.5 ring-1 ring-slate-200 hover:bg-slate-200/60" do %>
                    <span class="material-symbols-rounded text-sm">apartment</span>
                    <span><%= job.company.name %></span>
                  <% end %>

                  <% if job.location.present? %>
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-0.5 ring-1 ring-slate-200">
                      <span class="material-symbols-rounded text-sm">location_on</span>
                      <span><%= job.location %></span>
                    </span>
                  <% end %>

                  <% if job.employment_type.present? %>
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-0.5 ring-1 ring-slate-200">
                      <span class="material-symbols-rounded text-sm">schedule</span>
                      <span><%= job.employment_type %></span>
                    </span>
                  <% end %>
                </div>
              </div>
            </div>

            <% if job.description.present? %>
              <p class="mt-3 text-sm leading-relaxed text-slate-600 line-clamp-3"><%= job.description %></p>
            <% end %>

            <div class="mt-4 flex items-center justify-between text-xs text-slate-500">
              <span>Posted <%= time_ago_in_words(job.created_at) %> ago</span>
              <div class="flex items-center gap-2">
                <%= link_to job_path(job),
                    class: "inline-flex items-center gap-1.5 rounded-xl border border-slate-200 px-3 py-1.5 text-sm font-medium text-slate-800 hover:bg-slate-50" do %>
                  <span class="material-symbols-rounded text-sm">visibility</span>
                  <span>View</span>
                <% end %>

                <% if user_signed_in? && (current_user.admin? || job.company.user_id == current_user.id) %>
                  <%= link_to job_job_applications_path(job),
                      class: "inline-flex items-center gap-1.5 rounded-xl border border-slate-200 px-3 py-1.5 text-sm font-medium text-slate-800 hover:bg-slate-50" do %>
                    <span class="material-symbols-rounded text-sm">inbox</span>
                    <span>Applications</span>
                  <% end %>

                  <%= link_to edit_job_path(job),
                      class: "inline-flex items-center gap-1.5 rounded-xl border border-slate-200 px-3 py-1.5 text-sm font-medium text-slate-800 hover:bg-slate-50" do %>
                    <span class="material-symbols-rounded text-sm">edit</span>
                    <span>Edit</span>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
          <!-- /Job card -->
        <% end %>
      </div>
    <% end %>
  </div>
</section>
<%= render "shared/footer" %>